<Window x:Class="NxDmx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NxDmx.App.Controls"
        Title="NX-DMX" Width="1520" Height="940" MinWidth="1200" MinHeight="740"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing" SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseUp="Window_PreviewMouseUp" PreviewTextInput="Window_PreviewTextInput">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Background="#050505" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Border Height="46" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="NX" FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Black"/>
                    </Border>
                    <RadioButton x:Name="NavFixtures" Uid="Fixtures" Style="{StaticResource NavButton}" Tag="▦" Content="FIXTURES" GroupName="Nav" Checked="Nav_Checked"
                                 ToolTip="Select fixtures and control their parameters (Ctrl+1)" AutomationProperties.AutomationId="NavFixtures"/>
                    <RadioButton x:Name="NavGroups" Uid="Groups" Style="{StaticResource NavButton}" Tag="◫" Content="GROUPS" GroupName="Nav" Checked="Nav_Checked"
                                 ToolTip="Groups of fixtures (Ctrl+2)" AutomationProperties.AutomationId="NavGroups"/>
                    <RadioButton x:Name="NavCuelists" Uid="Cuelists" Style="{StaticResource NavButton}" Tag="☰" Content="CUELISTS" GroupName="Nav" Checked="Nav_Checked"
                                 ToolTip="Cuelists and cues (Ctrl+3)" AutomationProperties.AutomationId="NavCuelists"/>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="12,6"/>
                    <RadioButton x:Name="NavPatch" Uid="Patch" Style="{StaticResource NavButton}" Tag="⇄" Content="PATCH" GroupName="Nav" Checked="Nav_Checked"
                                 ToolTip="Add fixtures and give them universes and addresses (Ctrl+4)" AutomationProperties.AutomationId="NavPatch"/>
                    <RadioButton x:Name="NavProfiles" Uid="Profiles" Style="{StaticResource NavButton}" Tag="✎" Content="PROFILES" GroupName="Nav" Checked="Nav_Checked"
                                 ToolTip="Fixture Manager: create and edit fixture profiles (Ctrl+5)" AutomationProperties.AutomationId="NavProfiles"/>
                    <RadioButton x:Name="NavUniverses" Uid="Universes" Style="{StaticResource NavButton}" Tag="≣" Content="UNIVERSES" GroupName="Nav" Checked="Nav_Checked"
                                 ToolTip="Create and configure DMX universes (Ctrl+6)" AutomationProperties.AutomationId="NavUniverses"/>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="12,6"/>
                    <RadioButton x:Name="NavOutput" Uid="Output" Style="{StaticResource NavButton}" Tag="⚙" Content="OUTPUT" GroupName="Nav" Checked="Nav_Checked"
                                 ToolTip="Network adapter, Art-Net destination and DMX monitor (Ctrl+7)" AutomationProperties.AutomationId="NavOutput"/>
                    <RadioButton x:Name="NavRemote" Uid="Remote" Style="{StaticResource NavButton}" Tag="⌁" Content="REMOTE" GroupName="Nav" Checked="Nav_Checked"
                                 ToolTip="Bitfocus Companion, Stream Deck, OSC (Ctrl+8)" AutomationProperties.AutomationId="NavRemote"/>
                    <RadioButton x:Name="NavShow" Uid="Show" Style="{StaticResource NavButton}" Tag="▤" Content="SHOW" GroupName="Nav" Checked="Nav_Checked"
                                 ToolTip="New, open and save shows (Ctrl+9)" AutomationProperties.AutomationId="NavShow"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="6,0,6,8">
                    <Button x:Name="UpdateButton" Style="{StaticResource GreenButton}" Visibility="Collapsed" FontSize="10" Padding="2,4"
                            Margin="0,0,0,6" AutomationProperties.AutomationId="UpdateButton" Click="Update_Click" Focusable="False"/>
                    <Button x:Name="VersionButton" Style="{StaticResource FlatButton}" FontSize="10" Padding="2,3" Foreground="{StaticResource MutedBrush}"
                            ToolTip="Check for updates" AutomationProperties.AutomationId="VersionButton" Click="CheckUpdates_Click" Focusable="False"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="7"/>
                <RowDefinition x:Name="BottomRow" Height="214" MinHeight="150" MaxHeight="330"/>
            </Grid.RowDefinitions>

            <!-- Header: view title, show, output controls, status -->
            <Border Background="#050505" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock x:Name="ViewTitle" Style="{StaticResource Heading}" MinWidth="150"/>
                        <TextBlock x:Name="ShowName" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="22,0,0,0"/>
                        <TextBlock x:Name="ShowDirty" Text=" ●" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center"
                                   ToolTip="Unsaved changes" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="MASTER" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
                        <c:LevelBar x:Name="MasterBar" Width="150" Height="28" Caption="" Fill="{StaticResource AmberBrush}"
                                    ToolTip="Grand master for all intensities"/>
                        <ToggleButton x:Name="BlackoutButton" Style="{StaticResource RedChip}" Content="BLACKOUT" Margin="10,0,0,0" Focusable="False"
                                      ToolTip="Switch every intensity off" Click="Blackout_Click" AutomationProperties.AutomationId="BlackoutButton"/>
                        <Rectangle Width="1" Height="22" Fill="{StaticResource LineBrush}" Margin="14,0"/>
                        <Border x:Name="StatusLed" Width="9" Height="9" Background="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" FontFamily="Consolas" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" MinWidth="170"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="ViewHost" Grid.Row="1" Focusable="False" IsTabStop="False"/>

            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False" ResizeDirection="Rows"
                          ToolTip="Drag to resize, double-click to reset" MouseDoubleClick="Splitter_DoubleClick"/>

            <!-- Bottom: programmer table / log, command line, keypad -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="KeypadColumn" Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <c:InfoPanel x:Name="Info"/>
                    <c:CommandLineBar x:Name="CommandBar" Grid.Row="1"/>
                </Grid>
                <c:Keypad x:Name="Pad" Grid.Column="1" Width="560" Height="204" VerticalAlignment="Top"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
