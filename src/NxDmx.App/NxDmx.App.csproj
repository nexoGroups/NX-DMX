<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NxDmx.Core\NxDmx.Core.csproj" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <AssemblyName>NX-DMX</AssemblyName>
    <RootNamespace>NxDmx.App</RootNamespace>
    <Product>NX-DMX</Product>
    <Authors>NX-DMX contributors</Authors>
    <!-- Release builds get the real version from the git tag (-p:Version=...); this is the development default. -->
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.cs has its own Main so that Velopack can run its install/update hooks before WPF starts. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
