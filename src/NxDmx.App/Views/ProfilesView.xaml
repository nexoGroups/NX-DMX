<views:ConsoleView x:Class="NxDmx.App.Views.ProfilesView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:views="clr-namespace:NxDmx.App.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" MinWidth="220"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Profile list -->
        <DockPanel Background="{StaticResource SurfaceBrush}">
            <WrapPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                <Button Content="New" Click="New_Click" Margin="0,0,4,4" MinWidth="56" Style="{StaticResource GreenButton}" ToolTip="Create an empty profile"
                        AutomationProperties.AutomationId="NewProfile"/>
                <Button Content="Copy" Click="Copy_Click" Margin="0,0,4,4" MinWidth="56" ToolTip="Make an editable copy of the selected profile"
                        AutomationProperties.AutomationId="CopyProfile"/>
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" Margin="0,0,4,4" MinWidth="56" Style="{StaticResource RedButton}"/>
                <Button Content="Import" Click="Import_Click" Margin="0,0,4,4" MinWidth="56" ToolTip="Load a .nxfixture file"/>
                <Button Content="Export" Click="Export_Click" Margin="0,0,4,4" MinWidth="56" ToolTip="Save the selected profile as a .nxfixture file"/>
            </WrapPanel>
            <ListBox x:Name="ProfileList" ItemContainerStyle="{StaticResource PlainListItem}" SelectionChanged="ProfileList_SelectionChanged"
                     AutomationProperties.AutomationId="ProfileList" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,6">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Display}" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Text="{Binding Info}" FontSize="10.5" Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <Rectangle Grid.Column="1" Fill="{StaticResource LineBrush}"/>

        <!-- Editor -->
        <Grid x:Name="Editor" Grid.Column="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                <StackPanel>
                    <TextBlock x:Name="ReadOnlyNote" Foreground="{StaticResource AmberBrush}" Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap"
                               Text="This is a built-in profile and cannot be changed. Press Copy to make an editable version."/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="NAME" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                            <TextBox x:Name="NameBox" Width="240" IsEnabled="{Binding CanEdit}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="ProfileName"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="MANUFACTURER" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                            <TextBox x:Name="ManufacturerBox" Width="200" IsEnabled="{Binding CanEdit}" Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="DMX CHANNELS" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−" Width="28" Click="FewerChannels_Click" Padding="0"/>
                                <TextBox x:Name="CountBox" Width="52" TextAlignment="Center" Margin="2,0" IsEnabled="{Binding CanEdit}"
                                         Text="{Binding ChannelCountText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ProfileChannels"/>
                                <Button Content="+" Width="28" Click="MoreChannels_Click" Padding="0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="330" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <!-- Channel table -->
                <DataGrid x:Name="ChannelGrid" ItemsSource="{Binding Channels}" IsReadOnly="False" SelectionMode="Single"
                          RowHeight="32" SelectionChanged="ChannelGrid_SelectionChanged" CanUserSortColumns="False"
                          AutomationProperties.AutomationId="ChannelTable">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CH" Binding="{Binding Offset}" Width="46" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="ATTRIBUTE" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{x:Static views:ProfileDraft.AttributeChoices}" SelectedItem="{Binding Attribute, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0,2" MinHeight="24" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="16-BIT FINE CH" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.FineChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding Fine, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" MinHeight="24"
                                              Visibility="{Binding IsUsed, Converter={x:Static views:BoolToVisibility.Instance}}"
                                              IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="DEFAULT %" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DefaultText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" MinHeight="24" Padding="4,0" TextAlignment="Right"
                                             Visibility="{Binding IsUsed, Converter={x:Static views:BoolToVisibility.Instance}}"
                                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="FUNCTIONS" Width="*" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FineOf}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FunctionSummary}" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Rectangle Grid.Column="1" Fill="{StaticResource LineBrush}"/>

                <!-- Functions of the selected channel -->
                <DockPanel Grid.Column="2" Background="{StaticResource SurfaceBrush}">
                    <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                        <TextBlock Text="FUNCTIONS AND DMX RANGES" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="FunctionTitle" Foreground="{StaticResource AmberBrush}" FontSize="14" Margin="0,3,0,2" Text="Select a channel"/>
                        <TextBlock x:Name="FunctionHint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"
                                   Text="Name a stretch of the channel, e.g. Gobo 3 at 24–31. In the Fixtures view each function becomes a button."/>
                    </StackPanel>
                    <Button x:Name="AddFunctionButton" DockPanel.Dock="Bottom" Content="+ Add function" Click="AddFunction_Click" Margin="12,6,12,12"
                            AutomationProperties.AutomationId="AddFunction"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="FunctionList" Margin="12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name"/>
                                        <TextBox Grid.Column="1" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" Margin="3,0,0,0" TextAlignment="Right" ToolTip="From DMX (0–255)"/>
                                        <TextBox Grid.Column="2" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Margin="3,0,0,0" TextAlignment="Right" ToolTip="To DMX (0–255)"/>
                                        <Button Grid.Column="3" Content="✕" Margin="3,0,0,0" Padding="7,0" Click="RemoveFunction_Click" Tag="{Binding}" ToolTip="Remove"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- Problems and actions -->
            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="14,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="14,0,0,0">
                        <Button x:Name="RevertButton" Content="Revert" Click="Revert_Click" Margin="0,0,6,0" MinWidth="80"/>
                        <Button x:Name="SaveButton" Content="Save profile" Click="Save_Click" Style="{StaticResource GreenButton}" MinWidth="120"
                                AutomationProperties.AutomationId="SaveProfile"/>
                    </StackPanel>
                    <TextBlock x:Name="Problems" TextWrapping="Wrap" MinHeight="34" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="EmptyNote" Grid.Column="2" Foreground="{StaticResource MutedBrush}" Margin="24" TextWrapping="Wrap"
                   Text="Choose a profile on the left, or press New to create one."/>
    </Grid>
</views:ConsoleView>
